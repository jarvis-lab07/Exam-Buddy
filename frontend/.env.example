# Exam-Buddy Environment Variables Template
# Copy this file to .env.local on your device:
#   cp .env.example .env.local

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-server-only

# Google OAuth 2.0 & Google Drive BYOS Integration
# Configure in Google Cloud Console (https://console.cloud.google.com)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret-server-only
NEXT_PUBLIC_GOOGLE_API_KEY=your-google-cloud-api-key-for-picker

# AI & Embedding Providers
NEXT_PUBLIC_GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-optional


